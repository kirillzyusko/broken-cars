# The game works without any of these values.
PORT=3001

# Set this when the host machine has multiple network adapters and the QR code
# should use a particular address, for example http://192.168.1.25:3000.
# PUBLIC_URL=

# Optional AI-powered defect assignment. Local random assignment is the default.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano

# Optional shorter rounds for local E2E testing. Production defaults are
# 60s build, 60s tuning, 3s countdown, and 90s race.
# BUILD_DURATION_MS=1000
# TUNING_DURATION_MS=1000
# START_COUNTDOWN_MS=500
# MAX_RACE_DURATION_MS=3000
