# The game works without any of these values.
PORT=3001

# Set this when the host machine has multiple network adapters and the QR code
# should use a particular address, for example http://192.168.1.25:3000.
# PUBLIC_URL=

# Optional AI-powered defect assignment. Local random assignment is the default.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano

# Optional shorter rounds for local manual testing. `npm run dev:fast` applies
# these values automatically. Production defaults are 60/60/5/90 seconds.
# BUILD_DURATION_MS=15000
# TUNING_DURATION_MS=15000
# START_COUNTDOWN_MS=1000
# MAX_RACE_DURATION_MS=10000
