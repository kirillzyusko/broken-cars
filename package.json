{
  "name": "broken-cars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "dev:fast": "BUILD_DURATION_MS=15000 TUNING_DURATION_MS=15000 START_COUNTDOWN_MS=1000 MAX_RACE_DURATION_MS=10000 node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test",
    "test:openai": "node --env-file-if-exists=.env scripts/openai-smoke.js",
    "check": "npm run test && npm run build",
    "map:pack": "node scripts/pack-corsica.js"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "express": "^5.1.0",
    "playcanvas": "^2.22.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5"
  }
}
